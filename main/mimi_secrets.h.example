/*
 * MimiClaw Build-time Secrets
 *
 * This is the ONLY way to configure MimiClaw.
 * Copy this file to mimi_secrets.h and fill in your values.
 * After any change, rebuild: idf.py fullclean && idf.py build
 *
 *   cp mimi_secrets.h.example mimi_secrets.h
 */

#pragma once

/* WiFi */
#define MIMI_SECRET_WIFI_SSID       ""
#define MIMI_SECRET_WIFI_PASS       ""

/* Telegram Bot */
#define MIMI_SECRET_TG_TOKEN        ""

/* LLM Provider - OpenAI (default) or Anthropic */
#define MIMI_SECRET_API_KEY         ""          /* OpenAI sk-... or Anthropic key */
#define MIMI_SECRET_MODEL           "gpt-4o-mini"
#define MIMI_SECRET_MODEL_PROVIDER  "openai"    /* "openai" or "anthropic" */
#define MIMI_SECRET_API_URL         ""          /* Optional: custom endpoint (e.g. LiteLLM proxy) */

/* HTTP Proxy (leave empty or set both) */
#define MIMI_SECRET_PROXY_HOST      ""
#define MIMI_SECRET_PROXY_PORT      ""

/* Brave Search API */
#define MIMI_SECRET_SEARCH_KEY      ""

/* STT - set STT_URL empty to use local STT_HOST:STT_PORT server instead */
/* Models: gpt-4o-mini-transcribe (best), gpt-4o-transcribe, whisper-1 (basic) */
#define MIMI_SECRET_STT_URL         "https://api.openai.com/v1/audio/transcriptions"
#define MIMI_SECRET_STT_HOST        "192.168.1.100"
#define MIMI_SECRET_STT_PORT        "8000"
#define MIMI_SECRET_STT_MODEL       "gpt-4o-mini-transcribe"

/* TTS - set TTS_URL empty to use local STT_HOST:STT_PORT server instead */
/* Models: gpt-4o-mini-tts (best, supports instructions), tts-1 (low latency), tts-1-hd (high quality) */
/* Voices for gpt-4o-mini-tts: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse, marin, cedar */
/* Voices for tts-1/tts-1-hd:  alloy, ash, coral, echo, fable, onyx, nova, sage, shimmer */
#define MIMI_SECRET_TTS_URL         "https://api.openai.com/v1/audio/speech"
#define MIMI_SECRET_TTS_MODEL       "gpt-4o-mini-tts"
#define MIMI_SECRET_TTS_VOICE       "nova"
#define MIMI_SECRET_TTS_INSTRUCTIONS "Speak naturally and conversationally."
